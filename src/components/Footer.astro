---
import { site } from '../config/site';
import { services } from '../data/nav';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer section--deep">
  <div class="container container--wide">
    <div class="site-footer__grid">
      <div class="site-footer__col site-footer__brand">
        <a href="/" class="brand on-dark" aria-label={`${site.brand} – zur Startseite`}>
          <span class="brand__mark" aria-hidden="true"><Icon name="drop" size={24} /></span>
          <span class="brand__name">{site.brand}</span>
        </a>
        <!-- [PH-01] Exakte Firmierung vor Veröffentlichung prüfen -->
        <address class="site-footer__address">
          {site.legalName}<br />
          {site.address.street}<br />
          {site.address.zip} {site.address.city}
        </address>
        <ul class="site-footer__contact">
          <li>
            <Icon name="phone" size={16} />
            <a href={`tel:${site.phoneLink}`} class="tabular">{site.phoneDisplay}</a>
          </li>
          <li>
            <Icon name="mail" size={16} />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
        </ul>
        <p class="site-footer__hours">
          <Icon name="clock" size={16} />
          <span>{site.hours}</span>
        </p>
      </div>

      <div class="site-footer__col">
        <h2 class="site-footer__title">Leistungen</h2>
        <ul class="site-footer__links">
          {
            services.map((s) => (
              <li>
                <a href={`/leistungen/${s.slug}/`}>{s.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="site-footer__col">
        <h2 class="site-footer__title">Unternehmen</h2>
        <ul class="site-footer__links">
          <li><a href="/ueber-uns/">Über uns</a></li>
          <li><a href="/einsatzgebiete/">Einsatzgebiete</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/kontakt/">Kontakt</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__legal">
      <p>© {year} {site.brand}</p>
      <ul>
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/datenschutz/">Datenschutz</a></li>
      </ul>
    </div>
  </div>
</footer>
