---
// Signatur-Wellenkante an Sektionsübergängen (Messlinie-Motiv, Kap. 12).
// Sehr langsame, dezente horizontale Drift; deaktiviert unter reduced motion.
interface Props {
  flip?: boolean;
  class?: string;
}
const { flip = false, class: className = '' } = Astro.props;
---
<div class={`wave-divider ${className}`} aria-hidden="true">
  <svg
    class="wave-divider__svg motion-loop"
    viewBox="0 0 1200 60"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
    style={flip ? 'transform:scaleY(-1)' : undefined}
  >
    <path d="M0 30 C150 55 350 5 600 30 C850 55 1050 5 1200 30" />
  </svg>
</div>
