---
// Inline-SVG-Icons (Stroke-Stil 1.5px). Keine externen Requests.
// Dekorative Icons erhalten aria-hidden; sprechende erhalten einen title.
interface Props {
  name: string;
  class?: string;
  size?: number;
  title?: string;
  style?: string;
}
const { name, class: className = '', size = 24, title, style } = Astro.props;

const paths: Record<string, string> = {
