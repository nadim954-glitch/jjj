---
// Vorher/Nachher-Regler (Wiederherstellung). Schematische, selbst gezeichnete
// Illustration – KEIN reales Projektfoto (keine erfundenen Referenzen, Kap. 4.3).
// Native <input type="range">: per Maus, Touch und Tastatur bedienbar.
// Reveal-Animation beim Scrollen ins Blickfeld; unter reduced motion springt
// der Regler ohne Animation auf 55 % (Kap. 12).
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<div class={`compare ${className}`} data-compare>
  <div class="compare__frame">
    <svg class="compare__img compare__before" viewBox="0 0 400 300" role="img" aria-label="Zustand vor der Sanierung: durchfeuchtete Wand mit Wasserfleck und Pfütze">
      <rect width="400" height="300" fill="#eef2f6" />
      <path d="M40 258 H360" stroke="#c6d1db" stroke-width="2" />
      <path d="M56 258 V56 H344 V258" fill="none" stroke="#9aabb8" stroke-width="2" />
      <path d="M120 60c26 20 40 42 40 64a40 40 0 1 1-80 0c0-22 14-44 40-64Z" fill="#7ccdeb" opacity="0.4" />
      <path d="M150 132c14 12 22 22 22 34a22 22 0 1 1-44 0c0-12 8-22 22-34Z" fill="#2fa8dc" opacity="0.35" />
      <path d="M206 60 216 92 199 114 214 146" fill="none" stroke="#9aabb8" stroke-width="1.5" />
      <ellipse cx="230" cy="250" rx="72" ry="9" fill="#2fa8dc" opacity="0.35" />
      <path d="M170 250c10-4 20-4 30 0M212 250c10-4 20-4 30 0M254 250c10-4 20-4 30 0" fill="none" stroke="#1b8fc6" stroke-width="1.5" opacity="0.6" />
    </svg>
    <svg class="compare__img compare__after" data-compare-after viewBox="0 0 400 300" role="img" aria-label="Zustand nach der Sanierung: trockener, wiederhergestellter Raum">
      <rect width="400" height="300" fill="#ffffff" />
      <path d="M40 258 H360" stroke="#dde5ec" stroke-width="2" />
      <path d="M56 258 V56 H344 V258" fill="none" stroke="#0a2033" stroke-width="2" />
      <path d="M56 224 H344M56 244 H344" stroke="#eef2f6" stroke-width="2" />
      <rect x="96" y="98" width="76" height="56" rx="4" fill="none" stroke="#2fa8dc" stroke-width="1.5" />
      <rect x="110" y="184" width="64" height="40" rx="4" fill="none" stroke="#9aabb8" stroke-width="1.5" />
      <path d="M296 258v-46M296 212c-15 0-24-10-24-23 13 0 24 9 24 23Zm0 0c15 0 24-10 24-23-13 0-24 9-24 23Z" fill="none" stroke="#1b8fc6" stroke-width="1.5" />
    </svg>
    <div class="compare__seam"></div>
    <span class="compare__tag compare__tag--before">Vorher</span>
    <span class="compare__tag compare__tag--after">Nachher</span>
  </div>
  <input
    type="range"
    class="compare__range"
    min="0"
    max="100"
    value="0"
    step="1"
    aria-label="Vergleich Vorher/Nachher verschieben"
    data-compare-range
  />
  <p class="compare__caption">
    Schematische Darstellung des Ablaufs – kein reales Projektfoto.
  </p>
</div>
