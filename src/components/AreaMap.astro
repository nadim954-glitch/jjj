---
// Stilisierte, eigene SVG-Darstellung „Berlin + Umlandring" in Markenfarben.
// KEINE Kartendaten Dritter, keine Google Maps (Datenschutzvorgabe Kap. 17).
// Bewusst abstrahiert (kein Anspruch auf geografische Genauigkeit).
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<svg
  class={`area-map ${className}`}
  viewBox="0 0 400 360"
  role="img"
  aria-label="Stilisierte Karte des Einsatzgebiets Berlin und Umland"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <radialGradient id="am-glow" cx="50%" cy="46%" r="60%">
      <stop offset="0%" stop-color="#2fa8dc" stop-opacity="0.22" />
      <stop offset="100%" stop-color="#2fa8dc" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Umlandring (gestrichelt) -->
  <circle cx="200" cy="170" r="150" fill="url(#am-glow)" />
  <circle
    cx="200"
    cy="170"
    r="150"
    fill="none"
    stroke="#7ccdeb"
    stroke-width="1.5"
    stroke-dasharray="3 9"
    opacity="0.7"
  />

  <!-- Stilisierte Berlin-Fläche -->
  <path
    d="M150 92 L214 80 L252 96 L278 92 L300 120 L292 156 L308 186 L288 222 L250 248 L214 244 L182 262 L142 252 L112 220 L120 178 L104 148 L124 118 Z"
    fill="#0a2033"
    stroke="#1b8fc6"
    stroke-width="2"
    stroke-linejoin="round"
  />

  <!-- Messlinie quer durch die Fläche (Signatur) -->
  <path d="M120 178 L308 186" stroke="#2fa8dc" stroke-width="1.5" opacity="0.6" />
  <circle cx="200" cy="182" r="6" fill="#2fa8dc" />
  <circle cx="200" cy="182" r="11" fill="none" stroke="#2fa8dc" stroke-width="1.5" opacity="0.5" />

  <!-- Bezirkspunkte (abstrakt) -->
  <g fill="#7ccdeb">
    <circle cx="164" cy="132" r="3" />
    <circle cx="244" cy="128" r="3" />
    <circle cx="150" cy="210" r="3" />
    <circle cx="264" cy="216" r="3" />
    <circle cx="210" cy="238" r="3" />
  </g>

  <!-- Umlandpunkte auf dem Ring -->
  <g fill="#1b8fc6">
    <circle cx="200" cy="20" r="4" />
    <circle cx="350" cy="170" r="4" />
    <circle cx="200" cy="320" r="4" />
    <circle cx="50" cy="170" r="4" />
    <circle cx="94" cy="64" r="4" />
    <circle cx="306" cy="276" r="4" />
  </g>
</svg>
